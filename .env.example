# ---- CareAssist (https://getcareassist.com) — configuration ----
# Copiez ce fichier en .env puis adaptez.

# Base SQLite (créée automatiquement + données de démo)
DB_PATH=data/careassist.db
TIMEZONE=Europe/Paris

# Cabinets de démo : un par spécialité (voir app/seed.py). Cabinet utilisé par défaut
# par Twilio/Vapi si aucun practice_id n'est passé dans l'URL :
DEFAULT_PRACTICE=dentiste

# ---- LLM (optionnel) : sans clé, le moteur de règles déterministe est utilisé ----
# Option 1 : Groq (recommandé, rapide, compatible OpenAI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Option 2 : tout endpoint compatible OpenAI (OpenAI, Ollama, LM Studio, vLLM…)
# Ollama local : OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama  OPENAI_MODEL=llama3.1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=15

# Agenda : "sqlite" (défaut) ou "mock_google" (journalise des événements Google Calendar simulés)
CALENDAR_BACKEND=mock_google

# Super-admin (/admin) : PROTÉGÉ PAR DÉFAUT. Définissez un jeton long et aléatoire (en-tête X-Admin-Token).
# Sans jeton, /api/admin/* renvoie 401, sauf ADMIN_OPEN=1 (développement local uniquement).
ADMIN_TOKEN=
ADMIN_OPEN=0

# ---- Téléphonie ----
# Numéro vers lequel transférer l'appel à un humain (format E.164, ex. +33123456789)
HUMAN_TRANSFER_NUMBER=
TWILIO_VOICE=Polly.Lea
# Validation de signature Twilio (recommandé en production)
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE=false
# URL publique du site (production : https://getcareassist.com). Utilisée pour la validation de
# signature Twilio et pour les URL de retour des paiements. En local : laissez vide ou http://localhost:8000
PUBLIC_BASE_URL=https://getcareassist.com
# Secret partagé optionnel pour les webhooks Vapi (en-tête x-vapi-secret)
VAPI_SECRET=

# ---- Paiements (abonnement mensuel, un seul plan par région : voir app/pricing.py) ----
# Sans clé, le prestataire concerné fonctionne en MODE DÉMO : abonnement « pending » enregistré
# dans SQLite + page de paiement simulée /checkout/mock/<ref>. Forcer la démo : PAYMENTS_MODE=mock
PAYMENTS_MODE=auto
# Grille tarifaire personnalisée (JSON, mêmes clés que app/pricing.py). Prix par défaut = indicatifs à valider.
PRICING_FILE=
# Stripe Checkout (Europe, international, Maroc, Maghreb) : cartes + SEPA
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optionnel : ID de prix récurrent créé dans Stripe, par région (sinon price_data est envoyé)
# STRIPE_PRICE_EUROPE=
# Flutterwave (UEMOA XOF, CEMAC XAF, autres pays d'Afrique) : cartes + mobile money
FLW_SECRET_KEY=
# « Secret hash » défini dans le dashboard Flutterwave, renvoyé dans l'en-tête verif-hash
FLW_SECRET_HASH=
# Optionnel : plan de paiement récurrent Flutterwave par région, ex. FLW_PLAN_UEMOA=
# Paystack (Nigeria, Ghana, Kenya, Afrique du Sud) : cartes + mobile money (M-Pesa, MTN MoMo…)
# La signature x-paystack-signature est vérifiée avec cette même clé secrète.
PAYSTACK_SECRET_KEY=
# Optionnel : plan Paystack par région, ex. PAYSTACK_PLAN_NIGERIA=PLN_xxx

# ---- Espace cabinet / sécurité ----
# Cookie de session : auto = Secure si la requête arrive en HTTPS (ou X-Forwarded-Proto=https) ; true en production
COOKIE_SECURE=auto
BCRYPT_ROUNDS=12
RATE_LIMIT_ENABLED=1
# 1 = faire confiance à X-Forwarded-For (derrière Render/Nginx) pour la limitation de débit par IP
TRUST_PROXY=0
# Origines autorisées pour le widget public (chat/créneaux), séparées par des virgules ; vide = *
CORS_ORIGINS=
# Masquer /docs en production
DISABLE_DOCS=0
# Données de démo (cabinets FR/SN/CM + comptes de démo). Mettre 0 en production réelle.
SEED_DEMO=1

# ---- VoIP cloud : appels, SMS, WhatsApp (sans clé = MODE DÉMO, messages enregistrés en base uniquement) ----
# Forcer la démo : MESSAGING_MODE=mock. Les cabinets de démo n'envoient JAMAIS en réel (sauf DEMO_LIVE_MESSAGING=1).
MESSAGING_MODE=auto
DEMO_LIVE_MESSAGING=0
# Jeton partagé ajouté (?wt=) aux URL de webhook Vonage / Africa's Talking
VOIP_WEBHOOK_TOKEN=
# Twilio (voix + SMS + WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
# Vonage (Voice API NCCO + SMS API)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=CareAssist
# Africa's Talking (voix + SMS). AT_USERNAME=sandbox pour l'environnement de test
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contact@getcareassist.com
SMTP_STARTTLS=true

# ---- Planificateur (rappels, sauvegardes) ----
# 1 = APScheduler dans le processus web (UN SEUL processus) ; 0 = utiliser le cron (python -m app.cli …)
SCHEDULER_ENABLED=1
REMINDER_INTERVAL_S=60
BACKUP_DIR=
BACKUP_KEEP=7
BACKUP_HOUR_UTC=2
# Rétention des journaux techniques (appels, messages, conversations), en jours
RETENTION_DAYS=1095
